# Set up .env (run WITHOUT sudo, or the IDs become root's)
#   printf "MULTICORE_LAB_HOST_UID=%s\nMULTICORE_LAB_HOST_GID=%s\nMULTICORE_LAB_REPO_DIR=%s\nMULTICORE_LAB_KVM_GID=%s\n" "$(id -u)" "$(id -g)" "$(pwd)" "$(getent group kvm | cut -d: -f3)" > .env
#
# gem5's KVM CPU reads perf counters; if it complains, run once on the host:
#   sudo sysctl kernel.perf_event_paranoid=1
#

MULTICORE_LAB_HOST_UID=1000
MULTICORE_LAB_HOST_GID=1000
MULTICORE_LAB_REPO_DIR=/home/jsw/8sem/gem5-mcpat-hotspot-lab
MULTICORE_LAB_KVM_GID=994
